FLASK_ENV=development
SECRET_KEY=change-me-in-production
API_KEY=replace-with-a-secure-api-key

MODEL_WEIGHTS_PATH=../models/resnet34_224.pt
MODEL_ARCHITECTURE=resnet34
MODEL_INPUT_SIZE=224
MODEL_CLASS_NAMES=fake,real

MAX_CONTENT_LENGTH_MB=10
MIN_IMAGE_WIDTH=224
MIN_IMAGE_HEIGHT=224
MIN_FACE_SIZE=80

BLUR_THRESHOLD=30.0
CONTRAST_THRESHOLD=25.0